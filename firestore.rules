rules_version = '2';

// Reglas de seguridad de Firestore para Split App (clon de Splitwise).
// Publícalas en: Firebase Console -> Firestore Database -> Rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Perfiles públicos (solo nombre/email/foto) para mostrar a los miembros.
    // Cualquiera autenticado puede leer; cada uno solo escribe el suyo.
    match /users/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId;
    }

    match /groups/{groupId} {
      function isMember() {
        return signedIn() && request.auth.uid in resource.data.memberIds;
      }

      // Unirse a un grupo del que tienes el enlace/código: solo puedes
      // añadirte a ti mismo, sin quitar a nadie ni tocar otros campos.
      function joiningSelf() {
        return signedIn()
          && !(request.auth.uid in resource.data.memberIds)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.memberIds.removeAll(resource.data.memberIds) == [request.auth.uid];
      }

      allow read: if isMember();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if isMember() || joiningSelf();
      allow delete: if isMember() && resource.data.createdBy == request.auth.uid;

      // Gastos y pagos del grupo: solo los miembros.
      match /expenses/{expenseId} {
        function members() {
          return get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        }
        allow read, create, update, delete: if signedIn()
          && request.auth.uid in members();
      }
    }
  }
}
